<preferences EXTERNAL_XML_VERSION="1.0">
    <root type="user">
        <map/>
        <node name="rx">
            <map>
                <!-- Defines the schema version of our program properties. DO NOT MODIFY!! -->
                <entry key="schemaVersion" value="13"/>
            </map>
            <node name="program">
                <map>
                    <entry key="Name" value="TAKX"/>
                    <entry key="DefaultUserName" value="Default"/>

                    <!-- Select the database provider: postgres or hsqldb -->
                    <entry key="DatabaseType" value="hsqldb"/>

                    <!-- This entry controls the maximum dimension of the application frame. If it is set
                         to true, the application will attempt to use the maximum allowed screen real estate
                         available. If it is set to false, the application will start in the default size of
                         1024 x 768 in width x height. -->
                    <entry key="useMaximumWindowBounds" value="false"/>

                    <!-- This entry sets the maximum dimension (width or height of surface imagery graphics files.
                         The application will not allow the user to import a file that exceeds this dimension.
                         (Example, if the max dimension is 2048, then an image with width or height that exceeds
                         2048 pixels will be refused.) Attempting to import an image that exceeds the graphics card
                         buffer will result in getting a white square on a globe instead of the image. This limit
                         varies by system. 2048 is a reasonable default that will work with most systems.

                         There is a WorldWind bug that causes the memory usage to increase dramatically with each
                         surface image. A setting of 1024 (or smaller) is recommended until this issue is resolved.-->
                    <entry key="maxSurfaceImageDimension" value="1024"/>

                    <!-- This entry is the master control switch for the AutoReconnectService entries listed
                         elsewhere in this file.  When this value is false, the ability to auto-reconnect connections
                         is physically disabled; the entries aren't even parsed.  When this value is true, it becomes
                         possible to define 1 or more connections along with the pertinent metadata required to auto-
                         reconnect those connections when TAKX starts.  In the context of this switch, auto-
                         reconnect mean initiate network traffic and physically establish the connection. -->
                    <entry key="autoReconnectConnections" value="false"/>

                    <!-- This entry sets the tooltip behavior for map objects on the globe.  Values can be always on
                        ('on'), always off ('off') or ('default'). -->
                    <entry key="mapObjectTooltips" value="default"/>

                    <!-- This entry controls whether TAKX treats the network as "closed", meaning it will not have
                         access to the broader internet.  If "true", then no attempts to contact tak.gov (for elevation
                         data or layer definitions) will be made and all the default system-managed imagery layers
                         will be disabled. It will be up to the user, or the installer, to define any needed imagery
                         and elevation data sources. -->
                    <entry key="closedNetwork" value="false"/>

                    <!-- This is the default "WMS Offline Mode" setting.  If set true, then all new projects will
                         default to opening with WMS network access disabled.  If set false, then new projects will
                         open with normal (online) WMS network access enabled. -->
                    <entry key="defaultWMSOfflineMode" value="false"/>

                    <!-- Allow the user to override the font size of tooltips throughout TAKX. If this property is
                              set to -1, TAKX will use the default font size of 10pts (according to the current
                              look & feel).  Otherwise, specify the point size of the tooltip font (e.g. 20). -->
                    <entry key="tooltipFontSize" value="-1"/>

                    <!-- Disables the use of PKI Preferences in the User Preferences->Network Preferences panel.
                        set to true if PKI is not needed or causes a conflict with smart card readers -->
                    <entry key="DisablePKIPreferences" value="true"/>

                    <!-- This is an internal setting and should not be modified except under the direction of
                         TAKX support team members. -->
                    <entry key="EnableExternalSimulator" value="false"/>

                    <!-- This option, when enabled, causes TAKX to copy all data coming in across any connection
                         out to a file.  This can be used to capture an inbound data stream and then being able to
                         push it back into TAKX (as long as the plugin supports the FILE connection type). -->
                    <entry key="EnableCommLogging" value="false"/>

                    <!-- Controls whether the core initializes (and scans for) serial commports. -->
                    <entry key="EnableSerialPorts" value="true"/>

                    <!-- Set this to true to use the project explorer on launch. -->
                    <entry key="useProjectExplorer" value="false"/>

                    <!-- Always default to "Create" option in Project Explorer if true. If false, Project Explorer will
                         try to open the most recent project, default to "Create" if no recent project exists.
                         This setting only applies if 'useProjectExplorer' is true. -->
                    <entry key="defaultToNewProjectOnStart" value="false"/>

                    <!-- Enabling this entry allows a custom title to be used for the application. -->
                    <entry key="ApplicationTitle" value="TAKX"/>

                    <!-- Choose the minimum level that a data monitor must reach before being displayed in the Alarms HUD. -->
                    <entry key="MinHUDDataMonitorState" value="Warning"/>

                    <!-- Enable/disable the event log.  Default is false. -->
                    <entry key="enableEventLog" value="false"/>

                    <!-- Set the number of Event Log table rows.  When this max value is reached by incoming event logs,
                         the oldest event log is removed from the table for each newly added event log. -->
                    <entry key="maxEventLogTableRows" value="1000"/>

                    <!-- Set the maximum number of System Messages.  When this max value is reached in the System
                         Messages View, the oldest message is removed from the panel for each newly added message. -->
                    <entry key="maxVisibleSystemMessages" value="200"/>

                    <!-- Set true to provide a link to show exception stack traces in the system message view; false to not. -->
                    <entry key="systemMessageShowExceptionStack" value="true"/>

                    <!-- Set true to show the System Messages Notifications (count) panel in the bottom toolbar, false to hide it -->
                    <entry key="systemMessageNotificationsVisible" value="true"/>

                    <!-- Set the product flavor of the application. Can be CIV or MIL. -->
                    <entry key="productFlavor" value="CIV"/>

                    <!-- Configurable time server address.  If this key/value pair does not exist, TAKX will use the
                         default time server.  If the value is an empty string, then NO time server will be used. -->
                    <entry key="TimeServerHost" value="time.nist.gov"/>

                    <!-- Enable/disable the batching of RDMs. This will provide a mechanism whereby the core
                         is able to process RDMs in the background and not tie up the process flow with round trips
                         to the database. In general this is not needed except in the case of configurations which are
                         connected to sensors that have extremely high data volumes.

                         CAUTION: Setting this value to true could result in data loss.
                                  Since the data processing is happening in the background it is possible that in the
                                  face of an abrupt TAKX failure that the project could lose data that had been
                                  visualized on the globe (or elsewhere). -->
                    <entry key="RDMBatching" value="true"/>

                    <!-- Entry to enable/disable ability to import 2D KML files as a Raptor Structure  -->
                    <entry key="enable2DKMLShapeImportAsStructure" value="true"/>

                    <!-- If the layout of your screen configuration changes between launches of a project, TAKX will
                         sense this and revert back to the default layout (see conf/DefaultDocking.xml). This might
                         happen if you are on a laptop and disconnect an external monitor. If you would like to disable
                         this behavior, set this value to false. -->
                    <entry key="checkScreenConfig" value="true"/>

                    <!-- Enable the setting of a fetch size hint when querying for an RDM ResultSet.  Disable if
                         running pgAudit with Postgres as the former has a catastrophic bug associated with the
                         setFetchSize hint. -->
                    <entry key="enableSetFetchSize" value="true"/>

                    <!-- Email address to show in the error reporting dialog -->
                    <entry key="supportEmail" value="takx@tak.gov"/>

                    <!-- If true, the toolbar and side docked panels will not be visible to the user. -->
                    <entry key="SimplifiedUserInterface" value="false"/>

                    <!-- Comma separated list of WMS servers to ignore when calculating a timeout on Network status.
                         In the case of one or more unresponsive servers, even if others are responding,
                         TAKX would otherwise show the Network status as unavailable on the status bar and
                         display red LEDs for all of the imagery servers accessible through the Maps toolbar.

                         Example usage: value="data.worldwind.arc.nasa.gov,worldwind27.arc.nasa.gov" -->
                    <entry key="excludedUnresponsiveServers" value="data.worldwind.arc.nasa.gov"/>

                    <!-- The number of seconds to wait before removing an inactive contact from the Contacts list.
                         A negative value will disable this feature. -->
                    <entry key="ContactGoneTimeout" value="300"/>

                    <!-- When enabled, a button that can be used to delete individual contacts will be visible in the
                         Contacts panel. -->
                    <entry key="EnableIndividualContactDeletion" value="false"/>
                </map>

                <!-- Preferences controlling the globe appearance and user interactions. -->
                <node name="Globe">
                    <map>
                        <!-- If DisableCenterGlobeOnClick is false, then this setting determines the number of mouse
                             clicks required to cause a "center on" action on the globe. Legal values are 1 or 2. -->
                        <entry key="CenterGlobeOnClickCount" value="1"/>

                        <!-- Configurable default number of levels in Elevation Model pyramids.  This default is used when
                             connecting to an elevation WMS layer without knowledge of pyramid levels.
                             This is an optional key/value pair.  If this key/value pair does not exist, TAKX will
                             choose its own default. -->
                        <entry key="defaultElevationNumLevels" value="15"/>

                        <!-- Configurable default number of levels in Image Layer pyramids.  This default is used when
                             connecting to an imagery WMS layer without knowledge of pyramid levels.
                             This is an optional key/value pair.  If this key/value pair does not exist, TAKX will
                             choose its own default. -->
                        <entry key="defaultImageryNumLevels" value="14"/>

                        <!-- This option allows the user to disable the feature that makes TAKX center on whatever spot
                                  on the map the user clicks on. -->
                        <entry key="DisableCenterGlobeOnClick" value="true"/>

                        <!-- This option allows the user to disable their ability to use the keyboard to conduct globe
                                  navigation functions -->
                        <entry key="DisableKeyboardGlobeNavigation" value="false"/>

                        <!-- This option allows the user to disable their ability to use the mouse to conduct globe
                                  navigation functions -->
                        <entry key="DisableMouseGlobeNavigation" value="false"/>

                        <!-- This option allows the user to enable/disable support for multiple globes -->
                        <entry key="EnableMultipleGlobes" value="true"/>

                        <!-- This entry determines if TAKX will turn the use of OpenGL Frame Buffer Objects on or off.
                             Legal values are 'on' or 'off'.  The default value is 'on' and any illegal value will be
                             interpreted as 'on'. -->
                        <entry key="frameBuffering" value="on"/>

                        <!-- Controls what is displayed by the Position Overlay layer. true = mouse position,
                             false = view center position. -->
                        <entry key="positionOverlayTracksMouse" value="true"/>

                        <!-- This is the default value that globe layers will use to determine when to switch resolutions.
                             The value should be between -0.5 and 0.5.  Negative numbers decrease the relative detail of
                             the layer, values above 0.0 increase the detail (more tiles are used at higher elevations).
                             Default is 0.0.-->
                        <entry key="splitScale" value="0.0"/>

                    </map>
                    <node name="Animation">
                        <map>
                            <!-- Minimum length of time for a fly-to animation in milliseconds. -->
                            <entry key="FlyToMinLength" value="1000"/>
                            <!-- Maximum length of time for a fly-to animation in milliseconds. -->
                            <entry key="FlyToMaxLength" value="2500"/>
                            <!-- Minimum length of time for a heading animation in milliseconds. -->
                            <entry key="HeadingMinLength" value="500"/>
                            <!-- Maximum length of time for a heading animation in milliseconds. -->
                            <entry key="HeadingMaxLength" value="3000"/>
                            <!-- Minimum length of time for a pan animation in milliseconds. -->
                            <entry key="PanMinLength" value="1000"/>
                            <!-- Maximum length of time for a pan animation in milliseconds. -->
                            <entry key="PanMaxLength" value="2500"/>
                            <!-- Minimum length of time for a tilt animation in milliseconds. -->
                            <entry key="TiltMinLength" value="500"/>
                            <!-- Maximum length of time for a tilt animation in milliseconds. -->
                            <entry key="TiltMaxLength" value="3000"/>
                            <!-- Minimum length of time for a zoom animation in milliseconds. -->
                            <entry key="ZoomMinLength" value="1000"/>
                            <!-- Maximum length of time for a zoom animation in milliseconds. -->
                            <entry key="ZoomMaxLength" value="4000"/>
                        </map>
                    </node>
                </node>

                <!-- The location provider to use.  The core provides 3 built-in providers:
                     NoLocationProvider - always returns a null location
                     FixedLocationProvider - always returns a specific configured location
                     MapObjectTrackingLocationProvider - returns the location of a configfured MapObject

                     Plugins can also contribute location providers.
                -->
                <node name="locationProvider">
                    <map>
                        <entry key="selectedProvider" value="NoLocationProvider"/>

                        <!-- If true, then the current location will be indicated with a place marker -->
                        <entry key="showCurrentLocationMarker" value="true"/>
                    </map>
                    <node name="configurations">
                        <map/>
                    </node>
                </node>

                <!-- The toolbar configuration to install. -->
                <node name="ToolbarConfiguration">
                    <map>
                        <entry key="ActiveConfiguration" value="Default Configuration"/>
                        <entry key="DisplayDefaultConfiguration" value="true"/>
                    </map>
                </node>

                <!-- Parent node for all track rendering preferences. -->
                <node name="TrackRendering">
                    <map>
                        <!-- This entry controls which rendering engine is used to render track points on the globe.
                         There are two choices:

                         Spatial - supports full 3D orientation but has limitations on grouping and track point count
                         TopDown - optimized for top-down viewing, it groups nearby track points quickly and shows
                                   various levels of detail based on eye level.  It is optimize to handle nearly any
                                   volume of track points (based on the available memory on the machine) -->
                        <entry key="primaryRenderingMode" value="TopDown"/>
                    </map>
                </node>

                <!--  TODO KMB: Fix for FlatLAF -->
                <!-- The skin choices available to the user may be limited to the subset listed here.
                         The key and value must match the display name and class name, respectively, of a
                         class that extends SubstanceSkin and is available in the Substance library. -->
                <node name="Skins">
                    <map>
                        <entry key="Default Raptor Skin" value="DefaultRaptorSkin.class"/>
                        <entry key="Black Steel" value="BusinessBlackSteelSkin.class"/>
                        <entry key="Blue Steel" value="BusinessBlueSteelSkin.class"/>
                        <entry key="High Contrast Magma" value="MagmaSkin.class"/>
                        <entry key="Dark Gray on Light Gray" value="MistAquaSkin.class"/>
                    </map>
                </node>
                <!-- These values are used to configure CoT marker stale time handling. A marker's stale state is
                calculated using the stale time included in its CoT messages and the period of time since its last
                message was received. A marker may also be immediately made stale when a CoT delete task is received. A
                stale marker's icon will be colored gray and eventually deleted if it remains stale for longer than a
                configurable time period. -->
                <node name="StaleTime">
                    <map>
                        <!-- Time period (in seconds) to wait between stale checks -->
                        <entry key="StaleCheckPeriodSeconds" value="5"/>
                        <!-- Boolean that indicates if all CoT markers should be made stale after a period of inactivity -->
                        <entry key="ExpireEverything" value="true"/>
                        <!-- Boolean that indicates if CoT markers with unknown affiliations should be made stale after
                        a period of inactivity -->
                        <entry key="ExpireUnknowns" value="true"/>
                        <!-- Time period (in minutes) to wait before deleting stale CoT makers -->
                        <entry key="MinutesUntilDeleteStale" value="5"/>
                    </map>
                </node>
                <!-- Sample XML that shows how to define metadata for a given auto-reconnect connection -->
                <!-- Enabled on a per-connection basis -->
                <!--
                <node name="AutoReconnectService">
                  <map/>
                  <node name="Acme Connection">
                    <map>
                      <entry key="connectionKey" value="gov.takx.acme/AcmeV2Connection"/>
                    </map>
                  </node>
                </node>
                -->

                <!-- This node can be used to automatically install or start an app plugin. The app plugin JAR must
                already exist in the application's plugins directory. The entry key is the app plugin's unique key
                ("<family>/<type>"). The entry value should be "install", "start" or "background". "install" will add
                the app plugin to the Plugins panel but will not start it. "start" will automatically install (if needed)
                and start it. "background" will install and start the app plugin _without_ adding it to the Plugins panel.
                This option can be used when users should not be able to stop the app manually. -->
                <!--
                <node name="apps">
                    <map/>
                    <node name="configuration">
                        <map
                            <entry key="gov.takx.plugins.family/App Type 1" value="install"/>
                            <entry key="gov.takx.plugins.family/App Type 2" value="start"/>
                            <entry key="gov.takx.plugins.family/App Type 3" value="background"/>
                        </map>
                    </node>
                </node>
                -->
                <node name="apps">
                    <map/>
                </node>

                <!-- Uncomment this element to restrict the viewer to only a certain
                     part of the globe -->
                <!--<node name="viewLimits">-->
                <!--<map>-->
                <!--<entry key="minLat" value="40"/>-->
                <!--<entry key="maxLat" value="50"/>-->
                <!--<entry key="minLon" value="-130"/>-->
                <!--<entry key="maxLon" value="-120"/>-->
                <!--</map>-->
                <!--</node>-->

                <!-- The following sub-node contains the configuration related to developer mode. -->
                <node name="DeveloperMode">
                    <map>
                        <!-- Indicates if the developer settings should be visible in the preference UI. -->
                        <entry key="DeveloperSettingsEnabled" value="false"/>

                        <!-- Indicates if a radial menu option should be added to CoT objects which lets you view the
                        most recent CoT message that created/updated that object" -->
                        <entry key="CotMessageInspectionEnabled" value="false"/>

                        <!-- Enables continuous rendering mode to debug rendering issues. -->
                        <entry key="ContinuousRenderingEnabled" value="false"/>
                    </map>
                </node>

                <!-- The following sub-node contains the configuration related to the docking frames used in TAKX. -->
                <node name="DockingFrames">
                    <map>
                        <!-- To prevent frames from being maximized (and covering other frames), set to false. This only
                        relates to maximization for frames docked within TAKX.  For externalized (popped out) frames,
                        maximization is always enabled. -->
                        <entry key="FrameMaximizationEnabled" value="true"/>

                        <!-- To prevent externalized (popped out) frames from re-docking within TAKX when dragged over
                         the application, set to false.  This will still allow frames to be externalized/unexternalized,
                         but the appropriate buttons must be used instead.  Also, if this setting is false, the buttons
                         for moving/resizing will be removed from the externalized frame's border, since it can be
                         moved by simply dragging the title. -->
                        <entry key="DragAndDropToExternalizeEnabled" value="false"/>

                        <!-- To prevent globe frames from being minimized within TAKX, set to false. This setting
                         does not affect non-globe frames. -->
                        <entry key="GlobeMinimizationEnabled" value="false"/>

                        <!-- To prevent globe frames from being externalized or undocked from TAKX, set to false. This setting
                         does not effect non-globe frames. -->
                        <entry key="GlobeExternalizationEnabled" value="true"/>

                        <!-- To prevent a frame from being maximized when the title is double clicked, set to false.
                         The frames can still be maximized using the appropriate button unless FrameMaximizationEnabled
                         is also set to false. -->
                        <entry key="MaximizeOnDoubleClickEnabled" value="false"/>

                        <!-- Three "minimize areas" are normally displayed on the left/right/bottom of the main frame,
                        providing buttons for quick access to currently minimized panels. Setting this value to false
                        hides these areas, which can be nice to reduce clutter and regain screen real estate. -->
                        <entry key="MinimizeAreasEnabled" value="true"/>

                        <!-- to prevent secondary globe frames from being closed by the user, set to false. This setting does
                         not affect non-globe frames. -->
                        <entry key="SecondaryGlobesCloseEnabled" value="true"/>
                    </map>
                </node>

                <!-- Sub-node containing configurable properties for the Explorer Tree -->
                <node name="ExplorerTree">
                    <map>
                        <!-- Size in pixels for icons rendered in the Explorer Tree nodes.  Default is 24. -->
                        <entry key="iconSize" value="24"/>

                        <!-- Percent scaling for Explorer Tree text font.  Default is 130% -->
                        <entry key="textSizeScalingPercent" value="130"/>
                    </map>
                </node>

                <!-- Default configuration for Common Commo -->
                <node name="CommonCommo">
                    <map/>
                    <!-- These are the default ports on which we will listen for incoming communications -->
                    <node name="DefaultInputs">
                        <map/>

                        <node name="Default">
                            <map>
                                <entry key="uri" value="udp://0.0.0.0:4242"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="Default TCP">
                            <map>
                                <entry key="uri" value="tcp://0.0.0.0:4242"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="Wave Relay Multicast">
                            <map>
                                <entry key="uri" value="udp://239.23.212.230:18999"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="Wave Relay Multicast 2">
                            <map>
                                <entry key="uri" value="udp://227.8.135.15:18200"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="SA Multicast">
                            <map>
                                <entry key="uri" value="udp://239.2.3.1:6969"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="Services Multicast">
                            <map>
                                <entry key="uri" value="udp://224.67.111.84:18000"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="PRC-152">
                            <map>
                                <entry key="uri" value="udp://0.0.0.0:10011"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="Jumpmaster DIPs">
                            <map>
                                <entry key="uri" value="udp://0.0.0.0:8087"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="Request Notify">
                            <map>
                                <entry key="uri" value="tcp://0.0.0.0:8087"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="GeoChat Messages">
                            <map>
                                <entry key="uri" value="udp://224.10.10.1:17012"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="GeoChat Announce">
                            <map>
                                <entry key="uri" value="udp://224.10.10.1:18740"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                    </node>

                    <!-- These are the default ports on which we will use for outgoing communications -->
                    <node name="DefaultOutputs">
                        <map/>

                        <node name="Chat Output">
                            <map>
                                <entry key="uri" value="udp://224.10.10.1:17012"/>
                                <entry key="messageType" value="Chat"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                        <node name="SA Multicast">
                            <map>
                                <entry key="uri" value="udp://239.2.3.1:6969"/>
                                <entry key="messageType" value="SituationalAwareness"/>
                                <entry key="enabled" value="true"/>
                            </map>
                        </node>
                    </node>

                    <!-- Configures the set of network interfaces that should be used by commo as input and output channels.
                     By default, all interfaces will be used. -->
                    <node name="NetworkInterfaceOptions">
                        <map>
                            <entry key="UseAllNetworkInterfaces" value="true"/>
                        </map>
                        <node name="NetworkInterfaces">
                            <map/>
                        </node>
                    </node>

                    <!-- These are the TAK Server configurations -->
                    <node name="TakServers">
                        <map/>

                    </node>
                </node>

                <!--
                  set the saveWindowSettings to true to allow TAKX to "remember" your window position
                  between startups.
                  -->
                <node name="windowSettings">
                    <map>
                        <entry key="saveWindowSettings" value="true"/>
                    </map>
                </node>

                <!-- Specify the number of tracks that can be displayed before grouping logic is
                         applied at each track detail level. A user is able to select the level he/she
                         desires from the UI (Settings) and his/her selection is stored in the user
                         properties file. "high", "medium" and "low" are the only allowable entries.-->
                <node name="TrackDetailLevels">
                    <map>
                        <entry key="high" value="100000"/>
                        <entry key="medium" value="20000"/>
                        <entry key="low" value="2000"/>
                    </map>
                </node>

                <!-- Configure the notification options. Notifications consist of optional notification popups and a
                 "Notifications" panel that displays the notification history -->
                <node name="Notifications">
                    <map>
                        <entry key="PopupsEnabled" value="true"/>
                        <!-- The default amount of time popups will be displayed, in milliseconds. Individual requests to display
                        notifications may override this value -->
                        <entry key="DurationMs" value="4000"/>
                    </map>
                </node>

                <!-- Configuration for the Playback subsystem -->
                <node name="Playback">
                    <map>
                        <!-- When true, instead of stopping at the current displayed end of the timeline, the timeline is scrolled
                             and playback continues. When false, playback stops at the timeline end.-->
                        <entry key="autoScrollAtEnd" value="false"/>
                        <!-- When true, the 'live' icon will be displayed when in playback mode. Otherwise, the live icon will not be shown. -->
                        <entry key="showLiveMarkers" value="false"/>
                    </map>
                </node>

                <!-- This node can be used to customize the application menu. -->
                <node name="ApplicationMenu">
                    <!-- The example below shows how to add the "hiddenMenuItems" entry to hide menu items using a comma-delimited
                         list of menu item keys. The available keys include:

                          CLEAR_CONTENT, NEW_PROJECT, OPEN_PROJECT, PACKAGE_PROJECT, PLUGIN_PREFERENCES, PROJECT_CLEANER,
                          PROJECT_SETTINGS, QUIT, SAVE_PROJECT, SAVE_PROJECT_AS, SCREEN_SHOT_APPLICATION, SCREEN_SHOT_GEOTIFF,
                          SCREEN_SHOT_GLOBE, SCREEN_SHOT_MENU, SETTINGS

                        <map>
                            <entry key="hiddenMenuItems" value="CLEAR_CONTENT,PROJECT_CLEANER"/>
                        </map>
                    -->
                    <map/>
                </node>
            </node>
        </node>
    </root>
</preferences>
