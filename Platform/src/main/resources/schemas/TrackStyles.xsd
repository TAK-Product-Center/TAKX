<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:jxb="https://jakarta.ee/xml/ns/jaxb" jxb:version="3.0"
            targetNamespace="http://www.doe.gov/2011/RaptorTrackStyleSchema" version="1.0"
            xmlns="http://www.doe.gov/2011/RaptorTrackStyleSchema">

    <xsd:annotation>
        <xsd:documentation xml:lang="en">Proprietary Information Track Styles provide a means to
            remember a complete track style definition. The schema defines a mechanism for capturing
            which attributes are expressly defined, and which attributes should be defined by
            reaching back to the track style parent. Explicitly omitting a track style attribute
            results in a null value on parsing, thus indicating a request for explicit reach back.

            In the case of a ScopeType.Global, there is no explicit reach back capability. The track
            style is created with default values for all attributes, and only those track attributes
            explicitly set in the XML are re-defined.
        </xsd:documentation>
        <xsd:appinfo>
            <jxb:schemaBindings>
                <jxb:package name="gov.takx.platform.schema.trackstyle"/>
            </jxb:schemaBindings>
        </xsd:appinfo>
    </xsd:annotation>

    <xsd:complexType name="MetadataType" final="#all">
        <xsd:annotation>
            <xsd:documentation xml:lang="en">Metadata always consists of a sequential key-value
                pair. Both the key and the value are String based. Consult the TAKX SDK
                documentation for complete documentation on the full set of standardized keys that
                may be used.
            </xsd:documentation>
        </xsd:annotation>
        <xsd:sequence minOccurs="1" maxOccurs="unbounded">
            <xsd:element name="Key" type="xsd:string"/>
            <xsd:element name="Value" type="xsd:string"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="BucketModeType" final="#all">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="None"/>
            <xsd:enumeration value="HourOfDay"/>
            <xsd:enumeration value="DayOfWeek"/>
            <xsd:enumeration value="MonthOfYear"/>
            <xsd:enumeration value="Year"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="SizeType" final="#all">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="Minimum"/>
            <xsd:enumeration value="Small"/>
            <xsd:enumeration value="Normal"/>
            <xsd:enumeration value="Large"/>
            <xsd:enumeration value="Maximum"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="ScopeType" final="#all">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="Global"/>
            <xsd:enumeration value="User"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="VerticalAlignmentType" final="#all">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="Top"/>
            <xsd:enumeration value="Middle"/>
            <xsd:enumeration value="Bottom"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="GroupabilityType" final="#all">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="Ungroupable"/>
            <xsd:enumeration value="SimilarOnly"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="OpenGLShapeType" final="#all">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="Sphere"/>
            <xsd:enumeration value="Cone"/>
            <xsd:enumeration value="Cylinder"/>
            <xsd:enumeration value="Cube"/>
            <xsd:enumeration value="None"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:complexType name="GlyphType" final="#all">
        <xsd:annotation>
            <xsd:documentation>Collection of attributes that define an optional glyph resource</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="GlyphResource" type="xsd:string" minOccurs="0"/>
            <xsd:element name="VerticalAlignment" type="VerticalAlignmentType" minOccurs="0"/>
            <xsd:element name="VerticalOffset" type="xsd:float" minOccurs="0"/>
            <xsd:choice>
                <xsd:element name="LinkToTrackOpacity" type="xsd:boolean" minOccurs="0"/>
                <xsd:element name="Opacity" type="xsd:float" minOccurs="0"/>
            </xsd:choice>
            <xsd:choice>
                <xsd:element name="LinkToTrackSize" type="xsd:boolean" minOccurs="0"/>
                <xsd:element name="Size" type="SizeType" minOccurs="0"/>
            </xsd:choice>
            <xsd:element name="LinkToHeading" type="xsd:boolean" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="TrackShapeType" final="#all">
        <xsd:annotation>
            <xsd:documentation>Collection of attributes that define how the track shape is rendered.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="Shape" type="OpenGLShapeType" minOccurs="0"/>
            <xsd:element name="Color" type="xsd:int" minOccurs="0"/>
            <xsd:element name="Opacity" type="xsd:float" minOccurs="0"/>
            <xsd:element name="Size" type="SizeType" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Size definitions in XML are restricted to well-known sizes. The API provides
                        the ability to define any integer in the range of 1 to 10, inclusive.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="LinkToHeading" type="xsd:boolean" minOccurs="0" default="false"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="TrackStyleDefinitionType" final="#all">
        <xsd:sequence>
            <xsd:element name="Family" type="xsd:string"/>
            <xsd:element name="Type" type="xsd:string"/>
            <xsd:element name="UniqueKey" type="xsd:string"/>
            <xsd:element name="DisplayName" type="xsd:string"/>
            <xsd:element name="Scope" type="ScopeType" default="User" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>User scoped track style definitions are always parented by the global
                        track style definition. At most, one global track style definition can be defined in
                        a document that is an instance of this schema. If more than one global track style definition
                        is defined, the first one defined in the file is accepted, while the others are thrown away.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="UserDefined" type="xsd:boolean" minOccurs="0"/>
            <xsd:element name="Visible" type="xsd:boolean" minOccurs="0"/>
            <xsd:element name="TrackShape" type="TrackShapeType" minOccurs="0"/>
            <xsd:element name="Glyph" type="GlyphType" minOccurs="0"/>
            <xsd:element name="SnapToSurface" type="xsd:boolean" minOccurs="0"/>
            <xsd:element name="FadedOverTime" type="xsd:boolean" minOccurs="0"/>
            <xsd:element name="TimeThreshold" type="xsd:long" minOccurs="0"/>
            <xsd:element name="ElevationThreshold" type="xsd:int" minOccurs="0"/>
            <xsd:element name="ShowHeading" type="xsd:boolean" minOccurs="0"/>
            <xsd:element name="Groupability" type="GroupabilityType" minOccurs="0"/>
            <xsd:element name="BucketMode" type="BucketModeType" minOccurs="0"/>
            <xsd:element name="Metadata" type="MetadataType" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="TrackStyleDefinitionsCollection" final="#all">
        <xsd:annotation>
            <xsd:documentation>Collection of 1 or more track style definitions.
            </xsd:documentation>
        </xsd:annotation>
        <xsd:sequence minOccurs="1" maxOccurs="unbounded">
            <xsd:element name="TrackStyleDefinition" type="TrackStyleDefinitionType"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:element name="TrackStyleDefinitions" type="TrackStyleDefinitionsCollection"/>

</xsd:schema>
